{
  "name": "Atlas Inventory Bot Webhook",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "inventory-helper",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -300,
        -120
      ],
      "id": "1",
      "name": "Webhook Trigger",
      "webhookId": "atlas-inventory-helper"
    },
    {
      "parameters": {
        "text": "={{ $json.body?.question || $json.question || '' }}",
        "options": {
          "systemMessage": "You are Atlas Inventory Bot, an inventory assistant connected to a Flask API. Your job is to answer questions about product inventory using real data only. Rules: always use tools when the user asks about products, counts, stock, prices, value, or inventory. Never guess or hallucinate numbers. Use only the tool responses for factual claims. Respond in clear, natural English. Do not mention tools, endpoints, or internal system details."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        120,
        -120
      ],
      "id": "2",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4.1",
          "mode": "list",
          "cachedResultName": "gpt-4.1"
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        -40,
        100
      ],
      "id": "3",
      "name": "OpenAI Chat Model"
    },
    {
      "parameters": {
        "toolDescription": "Returns the total number of products in the catalog. Use this for questions about how many products exist overall.",
        "url": "http://127.0.0.1:5000/api/stats/total-products",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.4,
      "position": [
        120,
        100
      ],
      "id": "4",
      "name": "Get Product Count"
    },
    {
      "parameters": {
        "toolDescription": "Returns the current low-stock count. Use this for questions about low stock items or items low in stock.",
        "url": "http://127.0.0.1:5000/api/stats/low-stock",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.4,
      "position": [
        280,
        100
      ],
      "id": "5",
      "name": "Get Low Stock Count"
    },
    {
      "parameters": {
        "toolDescription": "Returns the total inventory value. Use this for questions about the total value of inventory.",
        "url": "http://127.0.0.1:5000/api/stats/inventory-value",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.4,
      "position": [
        440,
        100
      ],
      "id": "6",
      "name": "Get Inventory Value"
    },
    {
      "parameters": {
        "toolDescription": "Returns the most expensive product in the catalog. Use this for questions about the most expensive item or product.",
        "url": "http://127.0.0.1:5000/api/stats/most-expensive-product",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.4,
      "position": [
        600,
        100
      ],
      "id": "7",
      "name": "Get Most Expensive Product"
    },
    {
      "parameters": {
        "toolDescription": "Returns all products in the catalog. Use this for listing products or finding product names and categories.",
        "url": "http://127.0.0.1:5000/api/products",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.4,
      "position": [
        760,
        100
      ],
      "id": "8",
      "name": "Get All Products"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"question\": \"{{ $('Webhook Trigger').item.json.body?.question || $('Webhook Trigger').item.json.question || '' }}\",\n  \"answer\": \"{{ $json.output || $json.text || $json.response || $json.message || '' }}\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        420,
        -120
      ],
      "id": "9",
      "name": "Respond to Webhook"
    }
  ],
