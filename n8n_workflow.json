{
  "name": "A.R.I.A. Inventory Assistant",
  "nodes": [
    {
      "parameters": {
        "public": true,
        "availableInChat": true,
        "agentIcon": {
          "type": "icon",
          "value": "flask-conical"
        },
        "agentName": "A.R.I.A.",
        "agentDescription": "Atlas Robotics Inventory Assistant connected to the Flask API",
        "suggestedPrompts": {
          "prompts": [
            {
              "icon": {
                "type": "icon",
                "value": "package"
              },
              "text": "How many products do we have in the catalog?"
            },
            {
              "icon": {
                "type": "icon",
                "value": "triangle-alert"
              },
              "text": "How many products are low in stock?"
            },
            {
              "icon": {
                "type": "icon",
                "value": "badge-dollar-sign"
              },
              "text": "What is the total inventory value?"
            }
          ]
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.4,
      "position": [
        -300,
        -140
      ],
      "id": "1",
      "name": "When chat message received",
      "webhookId": "atlas-inventory-bot-chat-trigger",
      "alwaysOutputData": true,
      "executeOnce": true,
      "retryOnFail": true,
      "notesInFlow": true,
      "notes": "AI inventory assistant connected to the local Flask backend."
    },
    {
      "parameters": {
        "text": "={{ $json.chatInput }}",
        "options": {
          "systemMessage": "You are A.R.I.A. (Atlas Robotics Inventory Assistant), an inventory assistant connected to a Flask API. Your job is to answer questions about product inventory using real data only. Rules: always use tools when the user asks about products, counts, stock, prices, value, or inventory. Never guess or hallucinate numbers. Use only the tool responses for factual claims. Respond in clear, natural English. Do not mention tools, endpoints, or internal system details."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        240,
        -140
      ],
      "id": "2",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4.1",
          "mode": "list",
          "cachedResultName": "gpt-4.1"
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        20,
        80
      ],
      "id": "3",
      "name": "OpenAI Chat Model"
    },
    {
      "parameters": {
        "toolDescription": "Returns the total number of products in the catalog. Use this for questions about how many products exist overall.",
        "url": "http://localhost:5000/api/stats/total-products",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.4,
      "position": [
        180,
        80
      ],
      "id": "4",
      "name": "Get Product Count"
    },
    {
      "parameters": {
        "toolDescription": "Returns the current low-stock count. Use this for questions about low stock items or items low in stock.",
        "url": "http://localhost:5000/api/stats/low-stock",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.4,
      "position": [
        340,
        80
      ],
      "id": "5",
      "name": "Get Low Stock Count"
    },
    {
      "parameters": {
        "toolDescription": "Returns the total inventory value. Use this for questions about the total value of inventory.",
        "url": "http://localhost:5000/api/stats/inventory-value",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.4,
      "position": [
        500,
        80
      ],
      "id": "6",
      "name": "Get Inventory Value"
    },
    {
      "parameters": {
        "toolDescription": "Returns the most expensive product in the catalog. Use this for questions about the most expensive item or product.",
        "url": "http://localhost:5000/api/stats/most-expensive-product",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.4,
      "position": [
        660,
        80
      ],
      "id": "7",
      "name": "Get Most Expensive Product"
    },
    {
      "parameters": {
        "toolDescription": "Returns all products in the catalog. Use this for listing products or finding product names and categories.",
        "url": "http://localhost:5000/api/products",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.4,
      "position": [
        820,
        80
      ],
      "id": "8",
      "name": "Get All Products"
    }
  ],
  "pinData": {},
